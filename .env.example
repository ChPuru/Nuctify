# Nuctify environment variables
# Copy this file to .env and fill in what you need. Every key is optional:
# without Supabase the app runs fully offline (local library, no sign-in).
#
# NOTE: VITE_* values are baked into the web, desktop and mobile builds at
# build time and are visible to anyone who inspects the app. Only put
# public/client-side keys here — never a Supabase service_role key.

# Supabase (sign-in, cloud sync, Blend, collaborative playlists, Jam)
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Public web URL of your deployment (e.g. https://nuctify.vercel.app).
# Used by the desktop/Android apps to build "share playlist" links.
VITE_PUBLIC_WEB_URL=

# Spotify playlist import — https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# Last.fm scrobbling — https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=

# Discord Rich Presence (desktop app only; read by src-tauri/build.rs)
# https://discord.com/developers/applications
VITE_DISCORD_CLIENT_ID=

# ListenBrainz needs no key here — users paste their own token in Settings.
