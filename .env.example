# Nuctify Environment Variables Template
# Copy this file to .env and fill in your keys.

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Spotify Integration (Optional for playlist import)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Discord Integration (Optional for Desktop RPC)
VITE_DISCORD_CLIENT_ID=your_discord_application_id

# Last.fm Integration (Optional for scrobbling)
VITE_LASTFM_API_KEY=your_lastfm_api_key
VITE_LASTFM_SECRET=your_lastfm_secret

# ListenBrainz Integration (Optional for scrobbling)
# No API key needed for basic scrobbling with user token
